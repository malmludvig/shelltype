@inherits LayoutComponentBase
@inject SettingsService Settings

<div class="shell">
    <header class="top">
        <a class="logo" href="">
            <span class="prompt">~$</span> shelltype<span class="cursor"></span>
        </a>
        <nav>
            <NavLink href="" Match="NavLinkMatch.All" title="type">type</NavLink>
            <NavLink href="quiz" title="command quiz">quiz</NavLink>
            <NavLink href="learn" title="browse commands">learn</NavLink>
            <NavLink href="stats" title="your stats">stats</NavLink>
            <NavLink href="settings" title="settings">settings</NavLink>
            <NavLink href="about" title="about">about</NavLink>
        </nav>
    </header>

    <main>
        @if (_ready)
        {
            <ErrorBoundary>
                @Body
            </ErrorBoundary>
        }
    </main>

    <footer class="bottom">
        <div class="keys">
            <span><kbd>tab</kbd> restart</span>
            <span><kbd>enter</kbd> run command</span>
            <span><kbd>ctrl</kbd> + <kbd>backspace</kbd> delete word</span>
        </div>
        <div class="links">
            <span>theme: <a href="settings">@Settings.Current.Theme</a></span>
            <a href="https://github.com/malmludvig/shelltype" target="_blank" rel="noopener">github</a>
        </div>
    </footer>
</div>

@code {
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        await Settings.LoadAsync();
        Settings.Changed += StateHasChanged;
        _ready = true;
    }
}
