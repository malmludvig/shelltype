@* Test setup: mode, length, difficulty and command categories. Any change restarts the test. *@
@inject SettingsService SettingsService

<div class="config @(Hidden ? "hidden" : "")">
    <div class="group platform">
        <button class="@Active(S.Platform == Platform.Linux)" title="linux shell commands"
                @onclick="() => Change(s => SetPlatform(s, Platform.Linux))">linux</button>
        <button class="@Active(S.Platform == Platform.Cisco)" title="cisco ios commands for routers and switches"
                @onclick="() => Change(s => SetPlatform(s, Platform.Cisco))">cisco ios</button>
        <button class="@Active(S.Platform == Platform.Claude)" title="claude code slash commands, cli and flags"
                @onclick="() => Change(s => SetPlatform(s, Platform.Claude))">claude code</button>
        <button class="@Active(S.Platform == Platform.Linq)" title="c# linq statements over lists and arrays"
                @onclick="() => Change(s => SetPlatform(s, Platform.Linq))">c# linq</button>
    </div>

    <span class="divider"></span>

    <div class="group">
        <button class="@Active(S.Mode == TestMode.Time)" @onclick="() => Change(s => s.Mode = TestMode.Time)">time</button>
        <button class="@Active(S.Mode == TestMode.Commands)" @onclick="() => Change(s => s.Mode = TestMode.Commands)">commands</button>
        <button class="@Active(S.Mode == TestMode.Operations)"
                title="real tasks as sequences of commands"
                @onclick="() => Change(s => s.Mode = TestMode.Operations)">operations</button>
        @if (S.Platform == Platform.Cisco)
        {
            <button class="@Active(S.Mode == TestMode.Essentials)"
                    title="every one of the 50 most common cisco commands, once each"
                    @onclick="() => Change(s => s.Mode = TestMode.Essentials)">all 50</button>
        }
        else if (S.Platform == Platform.Claude)
        {
            <button class="@Active(S.Mode == TestMode.Essentials)"
                    title="every claude code command you can type, once each"
                    @onclick="() => Change(s => s.Mode = TestMode.Essentials)">all @ClaudeLibrary.Essentials.Count</button>
        }
        else if (S.Platform == Platform.Linq)
        {
            <button class="@Active(S.Mode == TestMode.Essentials)"
                    title="every linq statement, once each"
                    @onclick="() => Change(s => s.Mode = TestMode.Essentials)">all @LinqLibrary.Essentials.Count</button>
        }
    </div>

    @if (S.EffectiveMode != TestMode.Essentials)
    {
        <span class="divider"></span>

        <div class="group">
            @if (S.Mode == TestMode.Time)
            {
                @foreach (var seconds in TestConfig.TimeOptions)
                {
                    <button class="@Active(S.TimeSeconds == seconds)" @onclick="() => Change(s => s.TimeSeconds = seconds)">@seconds</button>
                }
            }
            else if (S.Mode == TestMode.Operations)
            {
                @foreach (var length in Enum.GetValues<OperationLength>())
                {
                    <button class="@Active(S.OperationLength == length)"
                            title="@LengthHint(length)"
                            @onclick="() => Change(s => s.OperationLength = length)">
                        @length.ToString().ToLowerInvariant()
                    </button>
                }
            }
            else
            {
                @foreach (var count in TestConfig.CommandOptions)
                {
                    <button class="@Active(S.CommandCount == count)" @onclick="() => Change(s => s.CommandCount = count)">@count</button>
                }
            }
        </div>
    }

    @* Operations and the essentials list are fixed, so difficulty and categories do not apply. *@
    @if (S.EffectiveMode is not (TestMode.Operations or TestMode.Essentials))
    {
        <span class="divider"></span>

        <div class="group">
            @foreach (var difficulty in Enum.GetValues<Difficulty>())
            {
                <button class="@Active(S.MaxDifficulty == difficulty)"
                        title="@DifficultyHint(difficulty)"
                        @onclick="() => Change(s => s.MaxDifficulty = difficulty)">
                    @difficulty.ToString().ToLowerInvariant()
                </button>
            }
        </div>

        @* The categories are Linux ones; the Cisco, Claude Code and LINQ lists are small enough to practice whole. *@
        @if (ShowCategoryControls)
        {
            <span class="divider"></span>

            <div class="group">
                <button class="@Active(_showCategories)" @onclick="() => _showCategories = !_showCategories">
                    categories @(S.Categories.Count == 0 ? "(all)" : $"({S.Categories.Count})")
                </button>
            </div>
        }
    }
</div>

@if (_showCategories && !Hidden && ShowCategoryControls)
{
    <div class="categories">
        <button class="chip @Active(S.Categories.Count == 0)" @onclick="() => Change(s => s.Categories.Clear())">all</button>
        @foreach (var category in Enum.GetValues<CommandCategory>())
        {
            <button class="chip @Active(S.Categories.Contains(category))" @onclick="() => Change(s => Toggle(s, category))">
                @category.ToString().ToLowerInvariant()
            </button>
        }
    </div>
}

@code {
    private bool _showCategories;

    [Parameter]
    public bool Hidden { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private UserSettings S => SettingsService.Current;

    private bool ShowCategoryControls => S.Platform == Platform.Linux && S.Mode != TestMode.Operations;

    private static string Active(bool on) => on ? "active" : "";

    private static string DifficultyHint(Difficulty d) => d switch
    {
        Difficulty.Easy => "short, simple commands",
        Difficulty.Medium => "easy + commands with flags and pipes",
        _ => "everything, including quotes, regexes and long paths",
    };

    private static string LengthHint(OperationLength length) => length switch
    {
        OperationLength.Short => "2-4 commands",
        OperationLength.Medium => "5-7 commands",
        _ => "8-10 commands",
    };

    private static void SetPlatform(UserSettings s, Platform platform)
    {
        s.Platform = platform;
        s.Mode = s.EffectiveMode;
    }

    private static void Toggle(UserSettings s, CommandCategory category)
    {
        if (!s.Categories.Remove(category))
        {
            s.Categories.Add(category);
        }

        // Selecting every category is the same as "all".
        if (s.Categories.Count == Enum.GetValues<CommandCategory>().Length)
        {
            s.Categories.Clear();
        }
    }

    private async Task Change(Action<UserSettings> change)
    {
        await SettingsService.UpdateAsync(change);
        await OnChanged.InvokeAsync();
    }
}
