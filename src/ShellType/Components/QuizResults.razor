@* End-of-quiz summary: score, accuracy, best combo, a per-topic breakdown and a review of every question. *@
@using ShellType.Quiz

<section class="results">
    <div class="headline">
        <div class="stat big">
            <div class="label">score</div>
            <div class="value">@Session.Score</div>
        </div>
        <div class="stat big">
            <div class="label">correct</div>
            <div class="value">@Session.CorrectCount/@Session.Total</div>
        </div>
        <div class="stat big">
            <div class="label">best combo</div>
            <div class="value">@Session.BestStreak</div>
        </div>
    </div>

    @if (IsHighScore)
    {
        <div class="badge pb">@(HighScore is null ? "first score for this quiz" : "new high score!")</div>
    }
    else if (HighScore is { } best)
    {
        <div class="badge">high score: @best</div>
    }

    <div class="actions">
        <button @onclick="OnRestart">play again → <kbd>enter</kbd></button>
        @if (Session.Answers.Any(a => !a.Correct))
        {
            <button @onclick="OnRetryMissed">retry the @Session.Answers.Count(a => !a.Correct) you missed</button>
        }
    </div>

    @if (Topics.Count > 1)
    {
        <h2>by topic</h2>
        <div class="topics">
            @foreach (var (topic, right, total) in Topics)
            {
                <span class="topic">@topic</span>
                <span class="meter"><i style="width:@(100 * right / total)%"></i></span>
                <span class="tally">@right/@total</span>
            }
        </div>
    }

    <h2>review</h2>
    <ol class="review">
        @foreach (var answer in Session.Answers)
        {
            var q = answer.Question;
            <li class="@(answer.Correct ? "ok" : "bad")">
                <span class="mark">@(answer.Correct ? "✓" : "✗")</span>
                <div>
                    @if (q.AsksForCommand)
                    {
                        <div class="task">@q.Prompt</div>
                    }
                    else
                    {
                        <div class="prompt"><span class="ps">@q.Shell</span> @q.Prompt</div>
                    }
                    @if (q.ErrorOutput is not null)
                    {
                        <div class="error">@q.ErrorOutput</div>
                    }
                    <div class="answer">→ @q.Answer</div>
                    @if (!answer.Correct)
                    {
                        <div class="yours">you: @(answer.Typed ?? q.Options[answer.ChosenIndex])</div>
                    }
                </div>
                <span class="points">@(answer.Points > 0 ? $"+{answer.Points}" : "")</span>
            </li>
        }
    </ol>
</section>

@code {
    [Parameter, EditorRequired]
    public QuizSession Session { get; set; } = default!;

    [Parameter]
    public int? HighScore { get; set; }

    [Parameter]
    public bool IsHighScore { get; set; }

    [Parameter]
    public EventCallback OnRestart { get; set; }

    [Parameter]
    public EventCallback OnRetryMissed { get; set; }

    /// <summary>Right answers per topic, for quizzes whose questions span several, like the Claude Code one.</summary>
    private IReadOnlyList<(string Topic, int Right, int Total)> Topics =>
        Session.Answers
            .Where(a => a.Question.Topic is not null)
            .GroupBy(a => a.Question.Topic!)
            .Select(g => (g.Key, g.Count(a => a.Correct), g.Count()))
            .OrderBy(t => t.Item1)
            .ToList();
}
